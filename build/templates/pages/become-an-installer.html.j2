{% extends "base.html.j2" %}
{% import "macros.html.j2" as m %}

{% block content %}

<section class="page-hero">
  <div class="container">
    <p class="breadcrumb" style="color:#cfe0f2;"><a href="{{ root }}index.html" style="color:#cfe0f2;">Home</a> / Become an Installer</p>
    <span class="hero-eyebrow">🛠️ Installer Program</span>
    <h1>Become a Trackingme Certified Installation Partner</h1>
    <p>We're building a national installation network for 12V technicians, automotive electronics installers, dashcam and GPS installers, and mobile mechanics.</p>
    <div class="hero-ctas" style="margin-top:26px;">
      <a href="#apply" class="btn btn-primary">Apply as an Installer</a>
    </div>
  </div>
</section>

<section>
  <div class="container">
    <div class="section-head reveal text-center">
      <span class="section-kicker">Why Partner With Us</span>
      <h2>What You Get</h2>
    </div>
    <div class="grid grid-4 reveal">
      <div class="solution-card"><div class="sc-icon">💼</div><h3>Additional Installation Jobs</h3><p>Commercial fleet work alongside your existing business.</p></div>
      <div class="solution-card"><div class="sc-icon">🎓</div><h3>Fleet Technology Training</h3><p>Trained on our ELD, GPS and dashcam configurations.</p></div>
      <div class="solution-card"><div class="sc-icon">🇨🇦</div><h3>Nationwide Opportunities</h3><p>Work as our installation network expands across Canada.</p></div>
      <div class="solution-card"><div class="sc-icon">📅</div><h3>Flexible Scheduling</h3><p>Take jobs that fit around your existing schedule.</p></div>
    </div>
  </div>
</section>

<section class="section-alt">
  <div class="container">
    <div class="section-head reveal">
      <span class="section-kicker">Who We're Looking For</span>
      <h2>Technicians With Relevant Experience</h2>
      <p class="section-lead">12V technicians, automotive electronics installers, dashcam installers, GPS technicians, truck accessory businesses and mobile mechanics.</p>
    </div>
  </div>
</section>

<section id="apply">
  <div class="container">
    <div class="section-head reveal text-center">
      <span class="section-kicker">Apply</span>
      <h2>Tell Us About Your Business</h2>
    </div>
    <div class="form-card" style="max-width:800px;margin:0 auto;">
      <form data-lead-form="installer-application" novalidate>
        <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" style="position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden;" aria-hidden="true">
        <div class="form-grid">
          <div class="form-field"><label for="ia-name">Full Name</label><input id="ia-name" name="name" type="text" required autocomplete="name"></div>
          <div class="form-field"><label for="ia-business">Business Name</label><input id="ia-business" name="company" type="text" required autocomplete="organization"></div>
          <div class="form-field"><label for="ia-email">Email</label><input id="ia-email" name="email" type="email" required autocomplete="email"></div>
          <div class="form-field"><label for="ia-phone">Phone</label><input id="ia-phone" name="phone" type="tel" required autocomplete="tel"></div>
          <div class="form-field"><label for="ia-province">Province</label>
            <select id="ia-province" name="province" required>
              <option value="">Select…</option>
              <option>Ontario</option><option>British Columbia</option><option>Alberta</option><option>Quebec</option><option>Manitoba</option><option>Saskatchewan</option><option>Atlantic Canada</option><option>Territories</option>
            </select>
          </div>
          <div class="form-field"><label for="ia-cities">Cities Served</label><input id="ia-cities" name="cities_served" type="text" required></div>
          <div class="form-field"><label for="ia-years">Years of Experience</label>
            <select id="ia-years" name="years_experience" required>
              <option value="">Select…</option>
              <option>Less than 1 year</option><option>1–3 years</option><option>4–10 years</option><option>10+ years</option>
            </select>
          </div>
          <div class="form-field"><label for="ia-mobile">Mobile Service?</label>
            <select id="ia-mobile" name="mobile_service">
              <option value="">Select…</option><option>Yes</option><option>No</option>
            </select>
          </div>
          <div class="form-field full"><label>Relevant Experience</label>
            <div class="checkbox-grid">
              <label class="checkbox-pill"><input type="checkbox" name="experience" value="12V"> 12V Electrical</label>
              <label class="checkbox-pill"><input type="checkbox" name="experience" value="GPS"> GPS Tracking</label>
              <label class="checkbox-pill"><input type="checkbox" name="experience" value="Dashcam"> Dashcams</label>
              <label class="checkbox-pill"><input type="checkbox" name="experience" value="Commercial Vehicle"> Commercial Vehicles</label>
            </div>
          </div>
        </div>
        <label class="consent-row">
          <input type="checkbox" required>
          <span>I consent to TrackingmeCA contacting me about the installer program, as described in the <a href="{{ root }}privacy-policy.html">Privacy Policy</a>.</span>
        </label>
        <button type="submit" class="btn btn-primary btn-block">Apply as an Installer</button>
      </form>
      <div class="form-success">
        <div class="fs-icon">✓</div>
        <h3>Thanks for applying.</h3>
        <p>Our installer program team will review your application and follow up.</p>
      </div>
    </div>
  </div>
</section>

{% endblock %}
