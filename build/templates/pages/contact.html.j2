{% extends "base.html.j2" %}
{% import "macros.html.j2" as m %}

{% block content %}

<section class="page-hero">
  <div class="container">
    <span class="hero-eyebrow">📬 Contact Us</span>
    <h1>Let's Build the Right Fleet Solution for You</h1>
    <p>Fill out the form below with as much detail as you can — we'll route your inquiry to the right specialist based on your industry and selected solutions, and follow up with a tailored quote.</p>
  </div>
</section>

<section>
  <div class="container split">
    <div>
      <span class="section-kicker">Get In Touch</span>
      <h2>We're Here to Help</h2>
      <ul class="feature-list">
        <li>No-obligation consultation and quote</li>
        <li>Canadian-based support team, Mon–Fri 7am–8pm ET</li>
        <li>Canada-wide installation scheduling</li>
      </ul>
      <div class="badge-row">
        <span class="badge-pill">📞 (416) 779-7382</span>
        <span class="badge-pill">✉️ info@trackingme.ca</span>
        <span class="badge-pill">🇨🇦 Serving all provinces &amp; territories</span>
      </div>
      <div class="divider"></div>
      <h3>Looking to Partner With Us?</h3>
      <p class="section-lead">Resellers, affiliates and installation partners should use our <a href="{{ root }}partners.html">dedicated partner application</a> instead.</p>
    </div>

    <div>
      <div class="form-card">
        <form data-lead-form="contact" novalidate>
          <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" style="position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden;" aria-hidden="true">
          <div class="form-grid">
            <div class="form-field"><label for="c-name">Full Name</label><input id="c-name" name="name" type="text" required autocomplete="name"></div>
            <div class="form-field"><label for="c-company">Company Name</label><input id="c-company" name="company" type="text" required autocomplete="organization"></div>
            <div class="form-field"><label for="c-email">Email Address</label><input id="c-email" name="email" type="email" required autocomplete="email"></div>
            <div class="form-field"><label for="c-phone">Phone Number</label><input id="c-phone" name="phone" type="tel" required autocomplete="tel"></div>
            <div class="form-field"><label for="c-city">City</label><input id="c-city" name="city" type="text" required></div>
            <div class="form-field"><label for="c-province">Province</label>
              <select id="c-province" name="province" required>
                <option value="">Select…</option>
                <option>Ontario</option><option>British Columbia</option><option>Alberta</option><option>Quebec</option><option>Manitoba</option><option>Saskatchewan</option><option>Atlantic Canada</option><option>Territories</option>
              </select>
            </div>
            <div class="form-field"><label for="c-industry">Industry</label>
              <select id="c-industry" name="industry" required>
                <option value="">Select…</option>
                <option>Trucking &amp; Transportation</option><option>Owner-Operator</option><option>Cold-Chain Logistics</option><option>Food &amp; Beverage Distribution</option>
                <option>Pharmaceutical / Healthcare</option><option>Taxi / Limousine</option><option>Car Rental</option><option>Delivery / Courier</option>
                <option>Construction / Heavy Equipment</option><option>School / Passenger Transportation</option><option>Municipal / Service Fleet</option>
                <option>Insurance</option><option>Fleet Leasing</option><option>Other</option>
              </select>
            </div>
            <div class="form-field"><label for="c-fleet">Fleet Size</label>
              <select id="c-fleet" name="fleet_size" required>
                <option value="">Select…</option>
                <option>1–5 vehicles</option><option>6–25 vehicles</option><option>26–100 vehicles</option><option>100+ vehicles</option>
              </select>
            </div>
            <div class="form-field"><label for="c-vehicle-types">Vehicle Types</label><input id="c-vehicle-types" name="vehicle_types" type="text" placeholder="e.g., Class 8 trucks, vans, reefer trailers"></div>
            <div class="form-field full"><label>Required Solution(s)</label>
              <div class="checkbox-grid">
                <label class="checkbox-pill"><input type="checkbox" name="solutions" value="ELD"> ELD</label>
                <label class="checkbox-pill"><input type="checkbox" name="solutions" value="AI Dashcam"> AI Dashcam</label>
                <label class="checkbox-pill"><input type="checkbox" name="solutions" value="GPS Tracking"> GPS Tracking</label>
                <label class="checkbox-pill"><input type="checkbox" name="solutions" value="Driver Monitoring"> Driver Monitoring</label>
                <label class="checkbox-pill"><input type="checkbox" name="solutions" value="Fuel Monitoring"> Fuel Monitoring</label>
                <label class="checkbox-pill"><input type="checkbox" name="solutions" value="CAN Bus Integration"> CAN Bus Integration</label>
                <label class="checkbox-pill"><input type="checkbox" name="solutions" value="Cold-Chain Monitoring"> Cold-Chain Monitoring</label>
                <label class="checkbox-pill"><input type="checkbox" name="solutions" value="Installation Services"> Installation Services</label>
                <label class="checkbox-pill"><input type="checkbox" name="solutions" value="Insurance Partnership"> Insurance Partnership</label>
                <label class="checkbox-pill"><input type="checkbox" name="solutions" value="Reseller / Affiliate Program"> Reseller / Affiliate Program</label>
              </div>
            </div>
            <div class="form-field"><label for="c-provider">Current Telematics Provider <span class="opt">(optional)</span></label><input id="c-provider" name="current_provider" type="text"></div>
            <div class="form-field"><label for="c-install-date">Preferred Installation Date <span class="opt">(optional)</span></label><input id="c-install-date" name="install_date" type="date"></div>
            <div class="form-field full"><label for="c-message">Message</label><textarea id="c-message" name="message" rows="3"></textarea></div>
          </div>
          <label class="consent-row">
            <input type="checkbox" required>
            <span>I consent to TrackingmeCA contacting me about this inquiry and, where applicable, to the collection of in-cab video/audio and telematics data as described in the <a href="{{ root }}privacy-policy.html">Privacy Policy</a>.</span>
          </label>
          <button type="submit" class="btn btn-primary btn-block">Submit Inquiry</button>
        </form>
        <div class="form-success">
          <div class="fs-icon">✓</div>
          <h3>Thank you — we've received your request.</h3>
          <p>A Canadian fleet advisor will review your details and follow up shortly, routed to the right specialist based on your industry and selected solutions.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section-alt">
  <div class="container text-center">
    <span class="section-kicker">Service Area</span>
    <h2>Canada-Wide Service, From Coast to Coast</h2>
    <div class="badge-row" style="justify-content:center;margin-top:16px;">
      <span class="badge-pill">Ontario</span><span class="badge-pill">British Columbia</span><span class="badge-pill">Alberta</span><span class="badge-pill">Quebec</span>
      <span class="badge-pill">Manitoba</span><span class="badge-pill">Saskatchewan</span><span class="badge-pill">Atlantic Canada</span><span class="badge-pill">Territories</span>
    </div>
  </div>
</section>

{% endblock %}
